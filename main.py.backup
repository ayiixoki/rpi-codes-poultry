def save_json_atomic(path, data):
    # write to a temp file first, so a power cut can't leave a half-written cache
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)

